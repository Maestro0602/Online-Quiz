# ============================================================================
# qiuizez — Environment Configuration Template (.env.example)
# Copy this file to `.env` and fill in your local values. Never commit `.env`!
# ============================================================================

# Server / API Runtime (Used in M2+ Full-Stack Branch)
PORT=3000
NODE_ENV=development

# PostgreSQL / Neon Database Connection String (SSL required for Neon)
DATABASE_URL=postgresql://username:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# 32-Byte Hex Key for AES-256-GCM Email Encryption & Scrypt Credential Hashing
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Vite Frontend Environment Variables (Used in M1 Prototype & Full-Stack)
VITE_APP_TITLE=qiuizez
VITE_API_BASE_URL=http://localhost:3000/api
VITE_MOCK_DELAY_MS=420
