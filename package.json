{
  "name": "quizchaos",
  "version": "1.0.0",
  "private": true,
  "description": "qiuizez - Collaborative Team Quiz Platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm --workspace=server run dev\" \"npm --workspace=client run dev\"",
    "build": "npm --workspace=shared run build && npm --workspace=client run build && npm --workspace=server run build",
    "start": "npm --workspace=server run start",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  }
}
